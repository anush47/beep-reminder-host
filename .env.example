# MongoDB connection (Atlas free tier works)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=beep_reminder

# Passwords typed into the website login box
SITE_PASSWORD=change-me-view        # can view reminders
ADMIN_PASSWORD=change-me-admin      # can create / edit / delete

# Secret the ESP32 sends in the x-api-key header
DEVICE_API_KEY=change-me-long-random-string

# Signs the login cookie (any long random string)
SESSION_SECRET=change-me-another-long-random-string

# IANA timezone that reminder times are interpreted in
TIMEZONE=Asia/Colombo
